{
  "name": "UNRENDERED",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "UNRENDERED": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "UNRENDERED_Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
