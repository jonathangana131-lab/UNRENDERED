{
  "schemaVersion": 1,
  "controlBranch": "swarm-control",
  "description": "UNRENDERED live GPT-5.6 Sol swarm coordination state",
  "leaseDefaults": {
    "primary": 1800,
    "review": 1200,
    "evidence": 2400,
    "integration": 1200
  },
  "wip": {
    "maxMajorEpics": 3,
    "maxPrimaryImplementationLanes": 6,
    "reviewBacklogThrottle": 4,
    "integrationBacklogThrottle": 3
  },
  "scheduler": {
    "redMainOverride": true,
    "idleAllowed": true,
    "requireValidatedState": true
  },
  "protectedScopes": [
    {"pattern": "Docs/PROJECT_STATE.md", "resource": "PROJECT-STATE"},
    {"pattern": "Docs/SWARM_V2_ACTIVATION.md", "resource": "PROJECT-STATE"},
    {"pattern": "Docs/SWARM_PROTOCOL.md", "resource": "SWARM-PROTOCOL"},
    {"pattern": "Docs/SWARM_CONTROL_PLANE.md", "resource": "SWARM-PROTOCOL"},
    {"pattern": "Docs/ADR/0004-swarm-control-plane.md", "resource": "SWARM-PROTOCOL"},
    {"pattern": "ProjectSource/UNRENDERED_PROJECT_INSTRUCTIONS.txt", "resource": "SWARM-PROTOCOL"},
    {"pattern": "tools/swarm/**", "resource": "SWARM-PROTOCOL"},
    {"pattern": ".github/workflows/swarm-control.yml", "resource": "SWARM-PROTOCOL"},
    {"pattern": ".github/workflows/ci.yml", "resource": "SWARM-PROTOCOL"},
    {"pattern": ".github/pull_request_template.md", "resource": "SWARM-PROTOCOL"},
    {"pattern": "src/shared/Reality/**", "resource": "REALITY-CONTRACT"},
    {"pattern": "src/server/Bootstrap.server.luau", "resource": "SERVER-AUTHORITY"}
  ],
  "foundry": {
    "enabled": true,
    "policyVersion": "17.0",
    "chatCapacityCeiling": 20,
    "maxOpenProductPRs": 18,
    "maxOpenBranches": 24,
    "retirementWorkers": 4,
    "verificationWorkers": 2,
    "redMainEmergencyBuilders": 1,
    "claimsRemainAuthoritative": true,
    "activationDeletesBranches": false
  }
}
